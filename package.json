    "test:http:catalog": "node --test tests/catalog-v2/http.test.mjs",
    "validate:directory": "node scripts/validate-directory.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.0"
  }
}
